# ============================================================
# Переменные админки. Задаются в панели хостинга, в репозиторий
# не коммитятся.
# ============================================================

# Пароль учреждения, в виде «соль:хеш». Сгенерировать:
#   node -e "const{scryptSync,randomBytes}=require('crypto');const s=randomBytes(16);console.log(s.toString('hex')+':'+scryptSync(process.argv[1],s,64).toString('hex'))" "ваш-пароль"
ADMIN_PASSWORD_HASH=

# Ключ для подписи куки сессии, не короче 32 символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Репозиторий с контентом и токен для записи в него.
# Токен — fine-grained, только на этот репозиторий, право Contents: Read and write.
# Редактор его не видит: он живёт только на сервере админки.
CONTENT_REPO=ВЛАДЕЛЕЦ/РЕПОЗИТОРИЙ
CONTENT_TOKEN=
CONTENT_BRANCH=main
