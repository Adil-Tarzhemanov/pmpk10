{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/flatten-segments.mjs",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit && tsc --noEmit -p admin",
    "check:content": "node scripts/check-content.mjs",
    "check:build": "node scripts/check-build.mjs",
    "e2e": "npm run build && npm run build --prefix admin && playwright test",
    "check": "npm run check:content && npm run lint && npm run type-check && npm run build && npm run check:build && npm run build --prefix admin && playwright test"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
